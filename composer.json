{
    "name": "verifaid/verifaid-php",
    "description": "Official VerifAID PHP SDK for extracting data from Indonesian identity documents: e-KTP, SIM, NPWP, BPJS, and Kartu Keluarga.",
    "type": "library",
    "keywords": [
        "verifaid",
        "ocr",
        "ktp",
        "e-ktp",
        "kartu-keluarga",
        "npwp",
        "sim",
        "bpjs",
        "kyc",
        "ekyc",
        "indonesia"
    ],
    "homepage": "https://verifaid.my.id",
    "license": "MIT",
    "authors": [
        {
            "name": "VerifAID",
            "email": "halo@verifaid.my.id",
            "homepage": "https://verifaid.my.id"
        }
    ],
    "support": {
        "email": "halo@verifaid.my.id",
        "issues": "https://github.com/d1g1reload/verifaid-php/issues",
        "source": "https://github.com/d1g1reload/verifaid-php",
        "docs": "https://verifaid.my.id/docs/api"
    },
    "require": {
        "php": "^7.4 || ^8.0",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "Verifaid\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Verifaid\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
